# Copy this file to backend/.env and adjust as needed.
# docker-compose.yml overrides DATABASE_URL and REDIS_URL to point at the
# `postgres`/`redis` service names automatically — you generally don't need
# to touch those two for local dev via docker-compose. They're here so the
# app also runs standalone (e.g. `uvicorn app.main:app` directly against a
# local Postgres/Redis).

ENVIRONMENT=development
DEBUG=true

# Comma-separated list of allowed frontend origins, or "*" for all.
# For the deployed frontend:
#   CORS_ORIGINS=https://status.pesaguard.victorkipruto.com
CORS_ORIGINS=*

DATABASE_URL=postgresql+asyncpg://pesaguard:pesaguard@localhost:5432/pesaguard_status
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=15

UPTIME_HISTORY_DAYS=90
